# Public project credentials (never use the service key here)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets; configure these on the hosting server, never in the browser
SUPABASE_SERVICE_ROLE_KEY=
FIRECRAWL_API_KEY=
CRON_SECRET=

# Optional scheduled internship research: comma separated, maximum three per run
CAREER_REFRESH_MAJORS=印刷工程,制浆造纸,包装工程

# LOCAL development only. Never grants access in a production build.
ALLOW_LOCAL_RESEARCH=false
NEXT_TELEMETRY_DISABLED=1
